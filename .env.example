# Production variables, per Railway service. Set them in the Railway dashboard
# (service > Variables > Raw Editor), never in a committed file.
# For local development use apps/api/.env.example and apps/web/.env.example.

# ════════════════ API service (Dockerfile.api / railway.api.json) ════════════════

# Database: reference the Railway Postgres plugin, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase auth: SUPABASE_URL (JWKS, ES256/RS256; required in production) and/or
# SUPABASE_JWT_SECRET (legacy HS256).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
# Required in production (needs SUPABASE_URL): account deletion also removes the
# Supabase auth user. Server-side only; never in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=sk-...
# Optional model overrides (defaults gpt-4o / gpt-4o-mini).
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_LIGHT=

# Stripe (live keys in production)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: free-trial days for first-time subscribers (0 = off, max 730).
STRIPE_TRIAL_DAYS=0
# Optional: extra comma-separated price ids that also grant premium (old or annual prices).
STRIPE_PREMIUM_PRICE_IDS=

# The web app's public https origin (CORS and Stripe redirects). Required in production.
CLIENT_URL=https://your-domain.com
# Optional: more web origins, comma-separated (e.g. the www and apex domains).
CORS_ORIGINS=
NODE_ENV=production
# Railway sets PORT itself; the image defaults to 3000.
# Reverse proxies in front of the API: 1 on Railway, 2 with Cloudflare proxying in front.
TRUST_PROXY_HOPS=1
# Optional: secret (32+ chars) for POST /interview-prep/admin/background-fill.
ADMIN_API_KEY=
# Recommended: lets in-flight requests finish on redeploys (seconds).
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60

# ════════════════ Web service (nixpacks.toml / railway.json) ════════════════
# Build-time and public (compiled into the bundle). server.js also reads the
# first two at runtime for its Content-Security-Policy.
VITE_API_URL=https://api.your-domain.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: endpoint for client error reports (JSON via sendBeacon); server.js
# adds its origin to the CSP connect-src. VITE_RELEASE tags the reports.
VITE_ERROR_REPORT_URL=
VITE_RELEASE=
