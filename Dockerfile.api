# syntax=docker/dockerfile:1
# API image (Railway service "api", see railway.api.json).
# Build: docker build -f Dockerfile.api -t career-portal-api .

ARG NODE_IMAGE=node:22-slim

# ── Dependencies: the API's, including the build tooling ────────────────────
FROM ${NODE_IMAGE} AS deps
ENV CI=true
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Manifests first: the install layer is reused until a dependency changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY libs/shared/types/package.json libs/shared/types/
COPY libs/web/data-access/package.json libs/web/data-access/
COPY libs/web/ui/package.json libs/web/ui/
RUN pnpm install --frozen-lockfile --filter @careerportal/api

# ── Production dependencies: no devDependencies (nx, typescript, ts-node) ───
# Reinstalled from the store the previous install filled (no downloads). The
# prisma CLI is a production dependency: the preDeployCommand runs it.
FROM deps AS prod-deps
RUN rm -rf node_modules apps/api/node_modules \
 && pnpm install --frozen-lockfile --filter @careerportal/api --prod --offline
COPY apps/api/prisma/schema.prisma apps/api/prisma/
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" \
    pnpm --filter @careerportal/api exec prisma generate --schema prisma/schema.prisma

# ── Build: Prisma client, compiled JS ───────────────────────────────────────
FROM deps AS build
COPY tsconfig.base.json ./
COPY apps/api apps/api
# `prisma generate` never connects; the URL only has to parse (not kept in the image).
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" \
    pnpm --filter @careerportal/api exec prisma generate --schema prisma/schema.prisma
# tsconfig.build.json leaves the *.spec.ts files out of dist.
RUN pnpm --filter @careerportal/api exec tsc -p tsconfig.build.json

# ── Runtime ─────────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PORT=3000

# tini runs as PID 1: forwards SIGTERM to node (graceful shutdown) and reaps
# Chromium's child processes.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Chromium headless shell + its system libraries for PDF rendering. Installed
# before the app so this large layer stays cached; keep the version equal to
# "playwright" in apps/api/package.json (checked below).
ARG PLAYWRIGHT_VERSION=1.58.2
RUN npx --yes playwright@${PLAYWRIGHT_VERSION} install --with-deps --only-shell chromium \
 && chmod -R a+rX /ms-playwright \
 && rm -rf /root/.npm /var/lib/apt/lists/*

RUN groupadd --system app \
 && useradd --system --gid app --create-home --home-dir /home/app --shell /usr/sbin/nologin app

WORKDIR /app
# Root-owned and read-only for the runtime user.
COPY --from=build /app/package.json ./package.json
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=prod-deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/dist ./dist
RUN node -e "const v = require('playwright/package.json').version; if (v !== process.env.PLAYWRIGHT_VERSION) { console.error('playwright ' + v + ' != PLAYWRIGHT_VERSION ' + process.env.PLAYWRIGHT_VERSION); process.exit(1); }"

USER app
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/apps/api/main.js"]
