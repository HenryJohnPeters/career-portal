# Local API environment. Copy to apps/api/.env (git-ignored) and fill in.
# Validated at boot by src/common/env.config.ts; the API refuses to start
# when something required is missing or malformed.

# ── Database (docker compose: `pnpm db:up`) ──
DATABASE_URL="postgresql://careerportal:careerportal@localhost:5432/careerportal?schema=public"

# ── Supabase auth (at least one of the first two) ──
# Project URL: verifies asymmetric (ES256/RS256) tokens via JWKS and the issuer.
SUPABASE_URL="https://your-project.supabase.co"
# Legacy JWT secret: only needed if the project still signs tokens with HS256.
SUPABASE_JWT_SECRET=""
# Server-side only; required when NODE_ENV=production: DELETE /account also deletes the Supabase user.
SUPABASE_SERVICE_ROLE_KEY=""

# ── OpenAI ──
OPENAI_API_KEY="sk-your-openai-api-key"
# Optional overrides (chat models with JSON mode). Premium uses standard, free uses light.
# OPENAI_MODEL_STANDARD="gpt-4o"
# OPENAI_MODEL_LIGHT="gpt-4o-mini"
# OPENAI_BASE_URL="https://your-openai-compatible-proxy/v1"

# ── Stripe (test mode locally) ──
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
# Printed by `stripe listen --forward-to localhost:3000/billing/webhook`.
STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_TRIAL_DAYS=0               # free-trial days for first-time subscribers (0 = off)
# STRIPE_PREMIUM_PRICE_IDS=""       # extra comma-separated price ids that grant premium

# ── App ──
CLIENT_URL="http://localhost:4200"
# CORS_ORIGINS=""                   # extra comma-separated web origins
PORT=3000
NODE_ENV=development
# TRUST_PROXY_HOPS=1                # reverse proxies in front of the API

# ── Admin ──
# Shared secret for POST /interview-prep/admin/background-fill (header x-admin-key), 32+ chars.
# ADMIN_API_KEY=""
