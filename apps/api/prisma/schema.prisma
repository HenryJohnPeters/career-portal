generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid())
  supabaseId     String?          @unique
  email          String           @unique
  name           String
  isPremium      Boolean          @default(false)
  stripeCustomerId     String?    @unique
  stripeCheckoutSessionId String? @unique
  stripeCheckoutSessionExpiresAt DateTime?
  stripeSubscriptionId String?    @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  /// Stripe subscription status mirror ("active", "trialing", "past_due", ...). Null = no subscription.
  subscriptionStatus   String?
  cancelAtPeriodEnd    Boolean    @default(false)
  trialEnd             DateTime?
  /// Set when the user first starts a Stripe trial; a user may trial only once.
  trialUsedAt          DateTime?
  onboardingDismissedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cvVersions     CvVersion[]
  answers        QuestionAnswer[]
  coverLetters   CoverLetter[]
  jobs           Job[]
  interviewSessions InterviewSession[]
  technicalTests    TechnicalTest[]
  aiUsages          AiUsage[]
  auditLogs      AuditLog[]
}

model CvVersion {
  id           String      @id @default(uuid())
  userId       String
  title        String
  isActive     Boolean     @default(false)
  templateId   String      @default("classic")
  themeConfig  Json        @default("{}")
  headerLayout String      @default("split")
  name         String?
  email        String?
  photoUrl     String?
  phone        String?
  location     String?
  website      String?
  linkedin     String?
  github       String?
  /// Previous sections + contact, captured before a bulk content apply (undo).
  lastSnapshot Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections     CvSection[]
  jobs         Job[]

  @@index([userId, updatedAt])
}

model CvSection {
  id          String    @id @default(uuid())
  cvVersionId String
  title       String
  content     String    @default("")
  sectionType String    @default("custom")
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cvVersion   CvVersion @relation(fields: [cvVersionId], references: [id], onDelete: Cascade)

  @@index([cvVersionId, order])
}

// LEGACY: Question/QuestionOption/QuestionAnswer are unused by current code.
// The interview system uses InterviewQuestion. Drop these tables in a future
// cleanup migration after verifying no production data depends on them.
model Question {
  id        String           @id @default(uuid())
  text      String
  type      QuestionType
  category  String
  createdAt DateTime         @default(now())
  options   QuestionOption[]
  answers   QuestionAnswer[]
}

enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
}

model QuestionOption {
  id         String           @id @default(uuid())
  questionId String
  text       String
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuestionAnswer[]
}

model QuestionAnswer {
  id               String          @id @default(uuid())
  userId           String
  questionId       String
  answerText       String?
  selectedOptionId String?
  skipped          Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id])
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([userId, questionId])
}

model CoverLetter {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String   @default("")
  jobId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  linkedFromJobs Job[] @relation("JobLinkedCoverLetter")

  @@index([userId, updatedAt])
  @@index([jobId])
}

model Job {
  id            String        @id @default(uuid())
  userId        String
  company       String
  role          String
  status        String        @default("applied")
  url           String?
  notes         String?
  cvVersionId   String?
  coverLetterId String?
  followUpDate  DateTime?
  jobDescription String?
  location      String?
  salary        String?
  appliedAt     DateTime?
  keySkills     String[]      @default([])
  /// Last deterministic CV-to-job keyword match score (0-100).
  matchScore    Int?
  matchCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverLetters  CoverLetter[]
  cvVersion     CvVersion?    @relation(fields: [cvVersionId], references: [id], onDelete: SetNull)
  linkedCoverLetter CoverLetter? @relation("JobLinkedCoverLetter", fields: [coverLetterId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, followUpDate])
  @@index([userId, updatedAt])
  @@index([cvVersionId])
  @@index([coverLetterId])
}

// === Interview Prep ===

model InterviewQuestion {
  id             String   @id @default(uuid())
  track          String
  tags           String[]
  difficulty     Int
  type           String
  level          String
  prompt         String
  options        Json     @default("[]")
  correctOptionIndex Int  @default(0)
  correctOptionIndices Int[] @default([])
  multiSelect    Boolean  @default(false)
  expectedPoints String[]
  redFlags       String[]
  rubric         Json
  modelAnswer    String
  followUpIds    String[]
  source         String   @default("seed") // "seed" | "ai-generated"
  generatedForHash String? // hash of the filter combo that triggered generation
  createdAt      DateTime @default(now())
  sessionQuestions InterviewSessionQuestion[]

  @@index([track, level, difficulty])
}

model InterviewSession {
  id              String   @id @default(uuid())
  userId          String
  track           String
  level           String
  tags            String[]
  roleFocus       String   @default("fullstack")
  interviewType   String   @default("coding")
  duration        Int      @default(60)
  difficulty      String   @default("medium")
  companyStyle    String   @default("startup")
  questionCount   Int      @default(10)
  persona         String   @default("neutral")
  interviewerId   String?  // interviewer config ID
  status          String   @default("in_progress")
  totalScore      Float?
  report          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       InterviewSessionQuestion[]

  @@index([userId, createdAt])
}

model InterviewSessionQuestion {
  id               String   @id @default(uuid())
  sessionId        String
  questionId       String
  orderIndex       Int
  userAnswer       String?
  score            Float?
  maxScore         Float    @default(10)
  feedback         Json?
  isFollowUp       Boolean  @default(false)
  parentQuestionId String?
  answeredAt       DateTime?
  createdAt        DateTime @default(now())
  session          InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         InterviewQuestion @relation(fields: [questionId], references: [id])

  @@index([sessionId, orderIndex])
  @@index([questionId])
}

// === Technical Tests ===

model TechnicalTest {
  id               String   @id @default(uuid())
  userId           String
  title            String
  track            String
  level            String
  difficulty       String   @default("medium")
  roleFocus        String   @default("fullstack")
  tags             String[]
  timeLimit        Int      @default(60)
  scenario         Json     // full scenario object (brief, requirements, criteria, etc.)
  status           String   @default("not_started") // not_started | in_progress | submitted | evaluated
  submission       String?  // user's solution text
  evaluation       Json?    // evaluation result
  startedAt        DateTime?
  submittedAt      DateTime?
  /// Soft delete: hidden from lists but still counted toward the monthly free quota.
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// === AI Usage Tracking ===

model AiUsage {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g. "cv-section", "cv-full", "cover-letter", "cover-letter-suggest", "cover-letter-rewrite", "question-generation", "scenario-generation"
  /// "pending" | "succeeded" | "failed". Only "succeeded" rows count toward the monthly quota.
  status    String   @default("succeeded")
  model     String?
  promptTokens     Int?
  completionTokens Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// === Question Generation Log ===

model QuestionGenerationLog {
  id                 String   @id @default(uuid())
  filterHash         String   // hash of the filter combo
  filterCombo        Json     // { track, level, difficulty, tags }
  questionsGenerated Int      // how many questions were created
  triggeredBy        String   // userId or "system"
  createdAt          DateTime @default(now())

  @@index([filterHash, createdAt])
  @@index([triggeredBy, createdAt])
}

// === Practice Question Daily Usage ===

// LEGACY: PracticeQuestionUsage is unused. Drop in a future cleanup migration.
model PracticeQuestionUsage {
  id        String   @id @default(uuid())
  userId    String
  questionId String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// === Audit Logging ===
// Tracks critical events: premium status changes, failed payments, etc.

model AuditLog {
  id          String    @id @default(uuid())
  /// Nulled when the user is deleted so the billing audit trail survives de-identified.
  userId      String?
  action      String    // e.g. "premium.downgraded", "payment.failed", "subscription.created"
  reason      String?   // e.g. "payment_declined", "subscription_expired", "manual_downgrade"
  metadata    Json?     // extra context (e.g. Stripe error, old value, new value)
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// === Stripe Webhook Event Tracking ===
// Durable idempotency store for Stripe webhook delivery retries/replays.

model StripeWebhookEvent {
  id         String   @id @default(uuid())
  eventId    String   @unique
  eventType  String
  createdAt  DateTime @default(now())
  processedAt DateTime?

  @@index([eventType, createdAt])
}
