# Local web environment. Copy to apps/web/.env (git-ignored).
# VITE_* values are public: they are compiled into the JavaScript bundle.
# Never put a secret here (no service-role key, no Stripe secret key).
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
# The project's public anon / publishable key.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: endpoint that receives unexpected client errors as JSON (sendBeacon,
# text/plain body). Its origin must be allowed by the CSP connect-src in server.js.
# VITE_ERROR_REPORT_URL=https://api.example.com/client-errors
# Optional: release id (e.g. the git commit) attached to those reports.
# VITE_RELEASE=
