# Local web environment. Copy to apps/web/.env (git-ignored).
# VITE_* values are public: they are compiled into the JavaScript bundle.
# Never put a secret here (no service-role key, no Stripe secret key).
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
# The project's public anon / publishable key.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
