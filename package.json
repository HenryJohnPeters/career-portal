{
  "name": "@careerportal/source",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api": "nx serve api",
    "web": "nx serve web",
    "db:up": "docker compose up -d",
    "db:migrate": "nx run api:prisma-migrate",
    "db:seed": "nx run api:prisma-seed",
    "db:generate": "nx run api:prisma-generate",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_PROJECT=apps/api/tsconfig.json node --test --require ts-node/register \"apps/api/src/**/*.spec.ts\"",
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "build:web": "pnpm --filter @careerportal/web build",
    "test:web": "pnpm --filter @careerportal/web test"
  },
  "devDependencies": {
    "nx": "20.3.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "compression": "1.8.1",
    "express": "4.22.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.1",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "multer": ">=2.1.1",
      "lodash": ">=4.17.23",
      "js-yaml": ">=4.1.1",
      "dompurify": "3.3.3",
      "path-to-regexp@<0.1.13": "0.1.13",
      "qs": "6.15.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
